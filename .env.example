# ── Notion public integration (https://www.notion.so/profile/integrations) ──
AUTH_NOTION_ID=
AUTH_NOTION_SECRET=
# Must exactly match a redirect URI on the integration's OAuth settings.
# Local: http://localhost:3000/api/auth/callback/notion
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/callback/notion

# ── Auth.js ──
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Optional locally; set to your production URL on Vercel (e.g. https://dial.example.com)
# AUTH_URL=

# ── Demo mode ──
# 1 = serve fixture data with no Notion connection (dev only).
DIAL_DEMO=0
